<UserControl x:Class="MarkView.Controls.FindReplacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             PreviewKeyDown="OnPanelPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="FindBox" ToolTip="Rechercher" VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged" KeyDown="OnFindBoxKeyDown" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                <ToggleButton x:Name="MatchCaseToggle" ToolTip="Respecter la casse" Click="OnSearchChanged" Content="Aa" />
                <ToggleButton x:Name="WholeWordToggle" ToolTip="Mot entier" Click="OnSearchChanged">
                    <TextBlock Text="ab" TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton x:Name="RegexToggle" ToolTip="Expression régulière" Click="OnSearchChanged" Content=".*" />
                <TextBlock x:Name="StatusText" MinWidth="110" Margin="8,0" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource Brush.ForegroundMuted}" />
                <Button ToolTip="Précédent (Maj+Entrée)" Click="OnPreviousClick"><TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" /></Button>
                <Button ToolTip="Suivant (Entrée)" Click="OnNextClick"><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" /></Button>
                <Button ToolTip="Fermer (Échap)" Click="OnCloseClick"><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" /></Button>
            </StackPanel>

            <TextBox x:Name="ReplaceBox" Grid.Row="1" Margin="0,4,0,0" ToolTip="Remplacer par" VerticalContentAlignment="Center"
                     KeyDown="OnReplaceBoxKeyDown" />
            <StackPanel x:Name="ReplaceButtons" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4,4,0,0">
                <Button Content="Remplacer" ToolTip="Remplacer (Entrée)" Padding="8,2" Click="OnReplaceClick" />
                <Button Content="Tout remplacer" Padding="8,2" Click="OnReplaceAllClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
