<UserControl x:Class="MarkView.Controls.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource Brush.Background}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="FindButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <!-- Keeps the keyboard focus in the search box. -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Docked above the WebView: WPF content can never be drawn over an HWND (airspace). -->
        <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="8,4"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FindButton}" Content="&#xE711;" Click="OnFindCloseClick"
                        ToolTip="Fermer (Échap)" AutomationProperties.Name="Fermer la recherche" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Font.Icons}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="0,0,6,0" />
                    <TextBox x:Name="FindBox" Width="260" Padding="4,2" VerticalContentAlignment="Center"
                             Background="{DynamicResource Brush.InputBackground}" Foreground="{DynamicResource Brush.Foreground}"
                             BorderBrush="{DynamicResource Brush.Border}" CaretBrush="{DynamicResource Brush.Foreground}"
                             AutomationProperties.Name="Rechercher dans l'aperçu"
                             PreviewKeyDown="OnFindBoxKeyDown" TextChanged="OnFindBoxTextChanged" />
                    <Button Style="{StaticResource FindButton}" Content="&#xE70E;" Click="OnFindPreviousClick"
                            ToolTip="Précédent (Maj+Entrée, Maj+F3)" AutomationProperties.Name="Résultat précédent" />
                    <Button Style="{StaticResource FindButton}" Content="&#xE70D;" Click="OnFindNextClick"
                            ToolTip="Suivant (Entrée, F3)" AutomationProperties.Name="Résultat suivant" />
                    <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Brush.ForegroundMuted}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <wv2:WebView2 x:Name="WebView" />
            <TextBlock x:Name="ErrorPanel" Visibility="Collapsed" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.ForegroundMuted}">
                <Run x:Name="ErrorText" />
                <LineBreak />
                <Hyperlink Click="OnDownloadRuntimeClick" Foreground="{DynamicResource Brush.Accent}">Télécharger le runtime WebView2</Hyperlink>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
