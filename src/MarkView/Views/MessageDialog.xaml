<Window x:Class="MarkView.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarkView" SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="560"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}">
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
        <Grid Margin="20,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource Font.Icons}" FontSize="28" VerticalAlignment="Top" />
            <TextBlock x:Name="MessageText" Grid.Column="1" Margin="16,4,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>
