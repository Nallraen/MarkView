<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Brush keys are a contract shared by every view: do not rename. -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Foreground" Color="#1F2328" />
    <SolidColorBrush x:Key="Brush.ForegroundMuted" Color="#656D76" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#F6F8FA" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#EAEEF2" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#DDE3E9" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D0D7DE" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#DBEAFE" />
    <SolidColorBrush x:Key="Brush.EditorBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.EditorForeground" Color="#1F2328" />
    <SolidColorBrush x:Key="Brush.EditorLineNumbers" Color="#8C959F" />
    <SolidColorBrush x:Key="Brush.EditorSelection" Color="#B6D4FE" />
    <SolidColorBrush x:Key="Brush.EditorCurrentLine" Color="#F6F8FA" />
    <SolidColorBrush x:Key="Brush.StatusBarBackground" Color="#F6F8FA" />
    <SolidColorBrush x:Key="Brush.StatusBarForeground" Color="#57606A" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C1C7CD" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#9AA3AB" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TabActive" Color="#FFFFFF" />
    <!-- Additional keys used by Controls.xaml and the dialogs. -->
    <SolidColorBrush x:Key="Brush.ForegroundDisabled" Color="#A0A7AF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Error" Color="#CF222E" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#BF8700" />
</ResourceDictionary>
